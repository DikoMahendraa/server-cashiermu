{
  "name": "cashiermu-api",
  "version": "1.8.1",
  "description": "CashierMu POS Backend API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "E2E=1 vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepare": "husky",
    "monitoring:token": "mkdir -p monitoring/secrets && grep '^METRICS_TOKEN=' .env | cut -d= -f2- | tr -d '\"' > monitoring/secrets/metrics_token",
    "monitoring:up": "npm run monitoring:token && docker compose -f monitoring/docker-compose.yml up -d",
    "monitoring:down": "docker compose -f monitoring/docker-compose.yml down",
    "monitoring:logs": "docker compose -f monitoring/docker-compose.yml logs -f --tail=100"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "8.1.0",
    "highlight.js": "^11.12.0",
    "jsonwebtoken": "^9.0.2",
    "markdown-it": "^14.3.3",
    "multer": "^2.4.0",
    "prom-client": "15.1.3",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/markdown-it": "^14.2.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.7",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
