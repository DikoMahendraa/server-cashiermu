NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:pass@localhost:5432/cashiermu

JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=cashiermu-assets

FRONTEND_ORIGIN=http://localhost:8081
# Public origin of this API; receipt links sent to customers are PUBLIC_BASE_URL/r/<token> (set it in production)
PUBLIC_BASE_URL=http://localhost:3000
# Number of reverse proxies in front of the API (nginx, Cloudflare, a PaaS router…): 1, 2, … Empty = reached directly.
# Without it, behind a proxy every user shares the proxy IP and a few failed logins lock everyone out.
TRUST_PROXY=
# Bearer token for GET /metrics (Prometheus / Grafana Alloy). Empty = /metrics is disabled in production. Use a long random string.
METRICS_TOKEN=change-me-long-random-string
LOG_LEVEL=info
# Also write JSON logs to this file so Grafana Alloy can ship them to Loki (see docs/13-monitoring.md)
LOG_FILE=
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# Throwaway account for the local end-to-end checkout script (npm run test:e2e).
# Local development only — registered automatically on first run. Never use in production.
E2E_API_URL=http://localhost:3000/api/v1
E2E_EMAIL=e2e-checkout@cashiermu.test
E2E_PHONE=080000000099
E2E_PIN=052293
# Second throwaway store, used to prove SKUs are unique per store and data is isolated between stores
E2E_EMAIL_2=e2e-checkout-2@cashiermu.test
E2E_PHONE_2=080000000098
# Third throwaway store, registered with the `craft` sector; used for sector, attributes and variant tests
E2E_EMAIL_3=e2e-checkout-3@cashiermu.test
E2E_PHONE_3=080000000097

# Developer docs site (/docs). On by default in development; OFF in production unless DOCS_ENABLED=true.
# If you enable it in production you MUST set DOCS_PASSWORD (otherwise /docs is not mounted).
# DOCS_ENABLED=true
# DOCS_USER=docs
# DOCS_PASSWORD=choose-a-long-random-password
