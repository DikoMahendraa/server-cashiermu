# Caddy gets and renews the HTTPS certificate for API_DOMAIN by itself (needs ports 80 and 443 open and the DNS
# record pointing at this server) and forwards requests to the API container.
{$API_DOMAIN} {
	encode zstd gzip

	# /metrics is for Prometheus / Alloy inside the private network only; it must not be reachable from the internet
	@metrics path /metrics /metrics/*
	respond @metrics 404

	header -Server

	reverse_proxy api:3000 {
		# One proxy hop in front of the API: matches TRUST_PROXY=1
		header_up X-Forwarded-For {remote_host}
	}
}

# Developer documentation on its own subdomain. It is the same /docs site the API serves (protected by DOCS_PASSWORD),
# so only /docs is forwarded; everything else on this name is a 404. Needs DNS: docs -> this server.
{$DOCS_DOMAIN} {
	encode zstd gzip
	header -Server

	redir / /docs/ 302

	# `handle` blocks are tried in order and the first match wins (plain `respond` would run before `reverse_proxy`)
	@docs path /docs /docs/*
	handle @docs {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		respond 404
	}
}

# The mobile app posts its telemetry (errors, slow calls, offline syncs) here; Caddy forwards it to Alloy's Faro
# receiver. Only works while Alloy is running (--profile monitoring). Needs DNS: telemetry -> this server.
{$TELEMETRY_DOMAIN} {
	encode zstd gzip
	header -Server

	@faro path /collect /collect/*
	handle @faro {
		reverse_proxy alloy:12347
	}

	handle {
		respond 404
	}
}
