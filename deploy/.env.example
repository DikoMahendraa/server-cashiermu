# Copy to deploy/.env on the SERVER (never commit the real file). Generate secrets with:  openssl rand -hex 32
# Use hex values (letters a-f and digits) for passwords and secrets so no character needs escaping.

# The public address of the API (DNS A record -> this server's IP). Caddy gets the HTTPS certificate for it.
API_DOMAIN=api.cashiermu.com
# Docs site (needs a DNS A record for this name too). Also set DOCS_ENABLED=true and DOCS_PASSWORD below to use it.
DOCS_DOMAIN=docs.cashiermu.com

# Database password (the API reaches the database as user "cashiermu" inside the private Docker network)
POSTGRES_PASSWORD=

# Login tokens. Two DIFFERENT random values, 32+ characters. The API refuses to start with weak or example values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public origin used in receipt links shared with customers
PUBLIC_BASE_URL=https://api.cashiermu.com
FRONTEND_ORIGIN=https://cashiermu.com

# One reverse proxy (Caddy) sits in front of the API. Needed so login limits see each user's own IP.
TRUST_PROXY=1

# Login protection
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# Monitoring (optional). /metrics is only reachable inside the Docker network (Caddy hides it from the internet).
METRICS_TOKEN=
LOG_LEVEL=info

# Developer docs site: leave off in production
DOCS_ENABLED=false
