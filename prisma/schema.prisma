generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                         String   @id @default(uuid())
  name                       String
  address                    String   @default("")
  phone                      String   @default("")
  email                      String   @default("")
  logoUrl                    String?
  receiptHeader              String   @default("")
  receiptFooter              String   @default("")
  taxEnabled                 Boolean  @default(false)
  taxRate                    Decimal  @default(0.10) @db.Decimal(5, 4)
  serviceChargeEnabled       Boolean  @default(false)
  serviceChargeRate          Decimal  @default(0.00) @db.Decimal(5, 4)
  currency                   String   @default("IDR")
  currencySymbol             String   @default("Rp")
  shiftEnabled               Boolean  @default(true)
  shiftRequireOpeningBalance Boolean  @default(true)
  shiftBranchSelection       Boolean  @default(true)
  globalDiscountEnabled      Boolean  @default(false)
  globalDiscountType         String   @default("percent")
  globalDiscountValue        Decimal  @default(0) @db.Decimal(15, 2)
  cashierCanDiscount         Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  users        User[]
  branches     Branch[]
  categories   Category[]
  products     Product[]
  shifts       Shift[]
  transactions Transaction[]
  pendingBills PendingBill[]
}

model User {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  email     String   @unique
  phone     String   @default("")
  role      UserRole @default(cashier)
  pinHash   String
  avatarUrl String?
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store         Store          @relation(fields: [storeId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  shifts        Shift[]
  transactions  Transaction[]
  refreshTokens RefreshToken[]
}

enum UserRole {
  owner
  cashier
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Branch {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  address   String   @default("")
  phone     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store        Store         @relation(fields: [storeId], references: [id])
  users        User[]
  shifts       Shift[]
  transactions Transaction[]
}

model Category {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  icon      String   @default("package")
  color     String   @default("#6366f1")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id])
  products Product[]
}

model Product {
  id         String   @id @default(uuid())
  storeId    String
  name       String
  sku        String   @unique
  barcode    String?  @unique
  categoryId String
  buyPrice   Decimal  @db.Decimal(15, 2)
  sellPrice  Decimal  @db.Decimal(15, 2)
  stock      Int      @default(0)
  minStock   Int      @default(5)
  imageUrl   String?
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  taxable         Boolean  @default(true)
  unit            String   @default("pcs")
  discountEnabled Boolean  @default(false)
  discountType    String   @default("percent")
  discountValue   Decimal  @default(0) @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store            Store             @relation(fields: [storeId], references: [id])
  category         Category          @relation(fields: [categoryId], references: [id])
  variantGroups    VariantGroup[]
  transactionItems TransactionItem[]
}

model VariantGroup {
  id          String  @id @default(uuid())
  productId   String
  name        String
  required    Boolean @default(false)
  multiSelect Boolean @default(false)
  sortOrder   Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options VariantOption[]
}

model VariantOption {
  id             String  @id @default(uuid())
  variantGroupId String
  label          String
  priceModifier  Decimal @default(0) @db.Decimal(15, 2)
  sortOrder      Int     @default(0)

  variantGroup VariantGroup @relation(fields: [variantGroupId], references: [id], onDelete: Cascade)
}

model Shift {
  id                String      @id @default(uuid())
  storeId           String
  userId            String
  branchId          String
  type              ShiftType
  openingBalance    Decimal     @default(0) @db.Decimal(15, 2)
  closingBalance    Decimal?    @db.Decimal(15, 2)
  cashSalesTotal    Decimal     @default(0) @db.Decimal(15, 2)
  digitalSalesTotal Decimal     @default(0) @db.Decimal(15, 2)
  transactionCount  Int         @default(0)
  variance          Decimal?    @db.Decimal(15, 2)
  status            ShiftStatus @default(open)
  notes             String      @default("")
  startedAt         DateTime    @default(now())
  closedAt          DateTime?

  store        Store         @relation(fields: [storeId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  transactions Transaction[]
}

enum ShiftType {
  pagi
  siang
  malam
}

enum ShiftStatus {
  open
  closed
}

model Transaction {
  id                  String            @id @default(uuid())
  storeId             String
  invoiceNumber       String            @unique
  shiftId             String?
  userId              String
  branchId            String
  subtotal            Decimal           @db.Decimal(15, 2)
  discountType        String?
  discountValue       Decimal?          @db.Decimal(15, 2)
  discountLabel       String?
  discountCode        String?
  discountAmount      Decimal           @default(0) @db.Decimal(15, 2)
  taxRate             Decimal           @default(0) @db.Decimal(5, 4)
  taxAmount           Decimal           @default(0) @db.Decimal(15, 2)
  serviceChargeRate   Decimal           @default(0) @db.Decimal(5, 4)
  serviceChargeAmount Decimal           @default(0) @db.Decimal(15, 2)
  grandTotal          Decimal           @db.Decimal(15, 2)
  cashPaid            Decimal           @default(0) @db.Decimal(15, 2)
  changeAmount        Decimal           @default(0) @db.Decimal(15, 2)
  customerName        String            @default("")
  status              TransactionStatus @default(paid)
  voidReason          String?
  voidedAt            DateTime?
  voidedBy            String?
  note                String            @default("")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  store    Store             @relation(fields: [storeId], references: [id])
  shift    Shift?            @relation(fields: [shiftId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  branch   Branch            @relation(fields: [branchId], references: [id])
  items    TransactionItem[]
  payments PaymentEntry[]
}

enum TransactionStatus {
  paid
  voided
  pending
}

model TransactionItem {
  id               String  @id @default(uuid())
  transactionId    String
  productId        String
  productName      String
  sku              String
  quantity         Int
  unitPrice        Decimal @db.Decimal(15, 2)
  subtotal         Decimal @db.Decimal(15, 2)
  note             String  @default("")
  selectedVariants Json    @default("[]")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
}

model PaymentEntry {
  id            String        @id @default(uuid())
  transactionId String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(15, 2)
  reference     String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  cash
  qris
  transfer
  debit_card
  credit_card
}

model PendingBill {
  id            String   @id @default(uuid())
  storeId       String
  label         String
  items         Json
  discountType  String?
  discountValue Decimal? @db.Decimal(15, 2)
  discountLabel String?
  subtotal      Decimal  @db.Decimal(15, 2)
  itemCount     Int
  branchId      String
  userId        String
  savedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
}
