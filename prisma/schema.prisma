generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Business type chosen at registration (Retail/Umum, Kuliner, Jasa & Layanan). It drives wording, units,
// starter categories and sector-specific product fields (see src/modules/sectors).
// `general` = no extra fields (how every store behaved before sectors existed).
enum BusinessSector {
  general
  culinary
  service
}

model Store {
  id                         String         @id @default(uuid())
  name                       String
  address                    String         @default("")
  phone                      String         @default("")
  email                      String         @default("")
  logoUrl                    String?
  receiptHeader              String         @default("")
  receiptFooter              String         @default("")
  taxEnabled                 Boolean        @default(false)
  taxRate                    Decimal        @default(0.10) @db.Decimal(5, 4)
  serviceChargeEnabled       Boolean        @default(false)
  serviceChargeRate          Decimal        @default(0.00) @db.Decimal(5, 4)
  currency                   String         @default("IDR")
  currencySymbol             String         @default("Rp")
  shiftEnabled               Boolean        @default(true)
  shiftRequireOpeningBalance Boolean        @default(true)
  shiftBranchSelection       Boolean        @default(true)
  globalDiscountEnabled      Boolean        @default(false)
  globalDiscountType         String         @default("percent")
  globalDiscountValue        Decimal        @default(0) @db.Decimal(15, 2)
  cashierCanDiscount         Boolean        @default(false)
  sector                     BusinessSector @default(general)
  // Kind of business inside the sector (e.g. service → laundry). Validated against the sector config, so new
  // kinds need no migration. `default` = the sector's only/first kind.
  subtype                    String         @default("default")
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  users        User[]
  branches     Branch[]
  categories   Category[]
  products     Product[]
  shifts       Shift[]
  transactions Transaction[]
  pendingBills PendingBill[]
  discounts    StoreDiscount[]
}

model StoreDiscount {
  id        String   @id @default(uuid())
  storeId   String
  label     String
  type      String   @default("percent")
  value     Decimal  @db.Decimal(15, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  email     String   @unique
  phone     String   @default("")
  role      UserRole @default(cashier)
  pinHash   String
  avatarUrl String?
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store         Store          @relation(fields: [storeId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  shifts        Shift[]
  transactions  Transaction[]
  refreshTokens RefreshToken[]
}

enum UserRole {
  owner
  cashier
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Branch {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  address   String   @default("")
  phone     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store        Store         @relation(fields: [storeId], references: [id])
  users        User[]
  shifts       Shift[]
  transactions Transaction[]
}

model Category {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  icon      String   @default("package")
  color     String   @default("#6366f1")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id])
  products Product[]
}

model Product {
  id              String   @id @default(uuid())
  storeId         String
  name            String
  sku             String
  barcode         String?
  categoryId      String
  buyPrice        Decimal  @db.Decimal(15, 2)
  sellPrice       Decimal  @db.Decimal(15, 2)
  stock           Int      @default(0)
  // false = unlimited / service: never checked or decremented at checkout
  trackStock      Boolean  @default(true)
  // Quantity may be fractional (2.5 kg, 1.5 hour). Only allowed together with trackStock = false.
  allowDecimalQty Boolean  @default(false)
  // Sector-specific values (e.g. prep time, expiry date). Shape and rules come from the store's sector config.
  attributes      Json     @default("{}")
  minStock        Int      @default(5)
  imageUrl        String?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  taxable         Boolean  @default(true)
  unit            String   @default("pcs")
  discountEnabled Boolean  @default(false)
  discountType    String   @default("percent")
  discountValue   Decimal  @default(0) @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store            Store             @relation(fields: [storeId], references: [id])
  category         Category          @relation(fields: [categoryId], references: [id])
  variantGroups    VariantGroup[]
  transactionItems TransactionItem[]

  // SKU and barcode are unique within a store, not across all stores
  @@unique([storeId, sku])
  @@unique([storeId, barcode])
}

model VariantGroup {
  id          String  @id @default(uuid())
  productId   String
  name        String
  required    Boolean @default(false)
  multiSelect Boolean @default(false)
  sortOrder   Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options VariantOption[]
}

model VariantOption {
  id             String  @id @default(uuid())
  variantGroupId String
  label          String
  priceModifier  Decimal @default(0) @db.Decimal(15, 2)
  sortOrder      Int     @default(0)

  variantGroup VariantGroup @relation(fields: [variantGroupId], references: [id], onDelete: Cascade)
}

model Shift {
  id                String      @id @default(uuid())
  storeId           String
  userId            String
  branchId          String
  type              ShiftType
  openingBalance    Decimal     @default(0) @db.Decimal(15, 2)
  closingBalance    Decimal?    @db.Decimal(15, 2)
  cashSalesTotal    Decimal     @default(0) @db.Decimal(15, 2)
  digitalSalesTotal Decimal     @default(0) @db.Decimal(15, 2)
  transactionCount  Int         @default(0)
  variance          Decimal?    @db.Decimal(15, 2)
  status            ShiftStatus @default(open)
  notes             String      @default("")
  startedAt         DateTime    @default(now())
  closedAt          DateTime?

  store        Store         @relation(fields: [storeId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  transactions Transaction[]
}

enum ShiftType {
  pagi
  siang
  malam
}

enum ShiftStatus {
  open
  closed
}

model Transaction {
  id                  String            @id @default(uuid())
  storeId             String
  invoiceNumber       String
  shiftId             String?
  userId              String
  branchId            String
  subtotal            Decimal           @db.Decimal(15, 2)
  discountType        String?
  discountValue       Decimal?          @db.Decimal(15, 2)
  discountLabel       String?
  discountCode        String?
  discountAmount      Decimal           @default(0) @db.Decimal(15, 2)
  taxRate             Decimal           @default(0) @db.Decimal(5, 4)
  taxAmount           Decimal           @default(0) @db.Decimal(15, 2)
  serviceChargeRate   Decimal           @default(0) @db.Decimal(5, 4)
  serviceChargeAmount Decimal           @default(0) @db.Decimal(15, 2)
  grandTotal          Decimal           @db.Decimal(15, 2)
  cashPaid            Decimal           @default(0) @db.Decimal(15, 2)
  changeAmount        Decimal           @default(0) @db.Decimal(15, 2)
  customerName        String            @default("")
  status              TransactionStatus @default(paid)
  voidReason          String?
  voidedAt            DateTime?
  voidedBy            String?
  note                String            @default("")
  // Client-generated key per checkout attempt; makes POST /transactions safe to retry.
  idempotencyKey      String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  store    Store             @relation(fields: [storeId], references: [id])
  shift    Shift?            @relation(fields: [shiftId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  branch   Branch            @relation(fields: [branchId], references: [id])
  items    TransactionItem[]
  payments PaymentEntry[]

  // Invoice sequences are per store (INV-YYYYMMDD-0001 restarts for every store).
  @@unique([storeId, invoiceNumber])
  @@unique([storeId, idempotencyKey])
}

enum TransactionStatus {
  paid
  voided
  pending
}

model TransactionItem {
  id               String   @id @default(uuid())
  transactionId    String
  productId        String
  productName      String
  sku              String
  quantity         Decimal  @db.Decimal(12, 3)
  unitPrice        Decimal  @db.Decimal(15, 2)
  // Product.buyPrice (HPP) per unit at the moment of sale, so profit stays correct when buy prices change later
  costPrice        Decimal  @default(0) @db.Decimal(15, 2)
  subtotal         Decimal  @db.Decimal(15, 2)
  note             String   @default("")
  selectedVariants Json     @default("[]")
  discountType     String?
  discountValue    Decimal? @db.Decimal(15, 2)
  discountLabel    String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
}

model PaymentEntry {
  id            String        @id @default(uuid())
  transactionId String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(15, 2)
  reference     String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  cash
  qris
  transfer
  debit_card
  credit_card
}

model PendingBill {
  id            String   @id @default(uuid())
  storeId       String
  label         String
  items         Json
  discountType  String?
  discountValue Decimal? @db.Decimal(15, 2)
  discountLabel String?
  subtotal      Decimal  @db.Decimal(15, 2)
  itemCount     Int
  branchId      String
  userId        String
  savedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
}
