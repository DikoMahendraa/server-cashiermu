    {
      "id": 10,
      "type": "timeseries",
      "title": "Slow API calls (ms, by route)",
      "description": "Calls slower than 3 seconds, as seen from the phone (includes the network)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (context_route) (max_over_time({job=\"cashiermu-app\", app_environment=~\"$env\", kind=\"measurement\"} | logfmt | unwrap value_ms [$__interval]))",
          "legendFormat": "{{context_route}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
